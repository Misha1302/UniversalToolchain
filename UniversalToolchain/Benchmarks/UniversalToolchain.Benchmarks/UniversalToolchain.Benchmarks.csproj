<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- Legacy and generated benchmark experiments are intentionally excluded from the public benchmark surface.
             They can be restored later as explicitly experimental benchmarks after their OperationsPerInvoke contract
             and generation pipeline are fixed. -->
        <Compile Remove="ArithmeticExecutionBenchmarks.cs"/>
        <Compile Remove="ExternalExecutionBenchmarks\ExternalWideExpression11ExecutionBenchmarks.cs"/>
        <Compile Remove="ExternalExecutionBenchmarks\Unrolled\**\*.cs"/>
        <None Include="ArithmeticExecutionBenchmarks.cs"/>
        <None Include="ExternalExecutionBenchmarks\ExternalWideExpression11ExecutionBenchmarks.cs"/>
        <None Include="ExternalExecutionBenchmarks\Unrolled\**\*"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\DynamicMethodCalling\DynamicMethodCalling.csproj"/>
        <ProjectReference Include="..\..\ExceptionsManager\ExceptionsManager.csproj"/>
        <ProjectReference Include="..\..\UniversalToolchain.Dialects.Wist\UniversalToolchain.Dialects.Wist.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.6"/>
        <PackageReference Include="NCalcSync" Version="5.12.0"/>
        <PackageReference Include="NCalc.LambdaCompilation" Version="5.12.0"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2"/>
        <PackageReference Include="DynamicExpresso.Core" Version="2.19.3"/>

    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\Dialects\examples\wist\full-default-native\dialect.wistdialect">
            <Link>Dialects\examples\wist\full-default-native\dialect.wistdialect</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
