<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\UniversalToolchain.Wist\UniversalToolchain.Wist.csproj"/>

        <!-- Keep source-tree benchmark runs behaviorally equivalent to package-consumer runs.
             UniversalToolchain.Wist package consumers receive the module assemblies/manifests as package content;
             project-reference benchmark runs need direct references so the same runtime descriptors are copied to output. -->
        <ProjectReference Include="..\..\ArithmeticModule\ArithmeticModule.csproj"/>
        <ProjectReference Include="..\..\CSharpInteropModule\CSharpInteropModule.csproj"/>
        <ProjectReference Include="..\..\CommentsModule\CommentsModule.csproj"/>
        <ProjectReference Include="..\..\ConditionsModule\ConditionsModule.csproj"/>
        <ProjectReference Include="..\..\EqualityModule\EqualityModule.csproj"/>
        <ProjectReference Include="..\..\FunctionCallsModule\FunctionCallsModule.csproj"/>
        <ProjectReference Include="..\..\IdentifierModule\IdentifierModule.csproj"/>
        <ProjectReference Include="..\..\InternalPreprocessorLexemesModule\InternalPreprocessorLexemesModule.csproj"/>
        <ProjectReference Include="..\..\LabelsModule\LabelsModule.csproj"/>
        <ProjectReference Include="..\..\LocalVariablesOptimizerModule\LocalVariablesOptimizerModule.csproj"/>
        <ProjectReference Include="..\..\LoopsModule\LoopsModule.csproj"/>
        <ProjectReference Include="..\..\NativeMathModule\NativeMathModule.csproj"/>
        <ProjectReference Include="..\..\NumbersModule\NumbersModule.csproj"/>
        <ProjectReference Include="..\..\ParametersSetterModule\ParametersSetterModule.csproj"/>
        <ProjectReference Include="..\..\SafeMathFunctionsModule\SafeMathFunctionsModule.csproj"/>
        <ProjectReference Include="..\..\ScopesModule\ScopesModule.csproj"/>
        <ProjectReference Include="..\..\SemicolonAsNewLineModule\SemicolonAsNewLineModule.csproj"/>
        <ProjectReference Include="..\..\UniversalToolchain.Ssa.Optimization\UniversalToolchain.Ssa.Optimization.csproj"/>
        <ProjectReference Include="..\..\VariablesModule\VariablesModule.csproj"/>
        <ProjectReference Include="..\..\WhitespacesModule\WhitespacesModule.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.6"/>
        <PackageReference Include="NCalcSync" Version="5.12.0"/>
        <PackageReference Include="NCalc.LambdaCompilation" Version="5.12.0"/>
    </ItemGroup>

    <PropertyGroup>
        <BenchmarkDialectRuntimeManifestPlatformSegment Condition="'$(Platform)' != '' and '$(Platform)' != 'AnyCPU'">$(Platform)/</BenchmarkDialectRuntimeManifestPlatformSegment>
    </PropertyGroup>

    <Target Name="CopyBenchmarkDialectRuntimeManifests" AfterTargets="Build">
        <ItemGroup>
            <_BenchmarkDialectRuntimeManifests Include="$(MSBuildProjectDirectory)/../../*/bin/$(BenchmarkDialectRuntimeManifestPlatformSegment)$(Configuration)/$(TargetFramework)/*.dialect.runtime.json"/>
        </ItemGroup>

        <Copy SourceFiles="@(_BenchmarkDialectRuntimeManifests)"
              DestinationFolder="$(TargetDir)"
              SkipUnchangedFiles="true"/>
    </Target>

    <Target Name="CopyBenchmarkRuntimeDllClosure" AfterTargets="Build">
        <ItemGroup>
            <!-- BenchmarkDotNet builds and executes a child project from an isolated output directory.
                 Runtime modules are discovered from manifests and loaded dynamically, so their transitive
                 dependencies are not always represented in the child project's deps.json. Copy the source-run
                 runtime closure into the current TargetDir so dynamically loaded modules resolve the same way
                 under BDN as they do under a normal source-tree benchmark run. -->
            <_BenchmarkRuntimeDllClosure Include="$(MSBuildProjectDirectory)/../../*/bin/$(BenchmarkDialectRuntimeManifestPlatformSegment)$(Configuration)/$(TargetFramework)/*.dll"/>
        </ItemGroup>

        <Copy SourceFiles="@(_BenchmarkRuntimeDllClosure)"
              DestinationFolder="$(TargetDir)"
              SkipUnchangedFiles="true"/>
    </Target>

</Project>
