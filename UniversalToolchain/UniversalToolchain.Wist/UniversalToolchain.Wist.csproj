<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
        <PackageId>UniversalToolchain.Wist</PackageId>
        <Version>0.1.0-alpha.6</Version>
        <Title>UniversalToolchain Wist</Title>
        <Description>Restricted formulas for .NET: validate rules, evaluate diagnostics, and compile approved formulas into typed delegates while the host owns inputs and side effects.</Description>
        <Authors>Mikhail Razakov</Authors>
        <PackageProjectUrl>https://misha1302.github.io/Wist2/</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Misha1302/Wist2</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageTags>dotnet;csharp;rule-engine;expression-engine;embedded-dsl;business-rules;formula;compiler;interpreter;cil;runtime;language-tooling;ssa;wist</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>Canonical LanguagePlan/LanguageRuntime facade migration candidate. This release intentionally does not provide binary compatibility with pre-hardening 1.0.0.0 runtime assemblies.</PackageReleaseNotes>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <DebugType>portable</DebugType>
        <NoWarn>$(NoWarn);NU5131</NoWarn>
        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeCanonicalWistRuntimeClosureInPackage</TargetsForTfmSpecificBuildOutput>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeFacadeReferenceAssemblyInPackage;IncludeRuntimeManifestsInPackage</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\UniversalToolchain.Wist.LanguagePack\UniversalToolchain.Wist.LanguagePack.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\UniversalToolchain.Runtime\UniversalToolchain.Runtime.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\UniversalToolchain.LanguageSdk\UniversalToolchain.LanguageSdk.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\UniversalToolchain.Language.Abstractions\UniversalToolchain.Language.Abstractions.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\UniversalToolchain.FeatureSdk\UniversalToolchain.FeatureSdk.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\UniversalToolchain.Ssa.Optimization\UniversalToolchain.Ssa.Optimization.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\BasicCilCompiler\BasicCilCompiler.csproj" PrivateAssets="all"/>
        <ProjectReference Include="..\BasicCore\BasicCore.csproj" PrivateAssets="all"/>
        <ProjectReference Include="..\CommonExceptions\CommonExceptions.csproj" PrivateAssets="all"/>
        <ProjectReference Include="..\ExceptionsManager\ExceptionsManager.csproj" PrivateAssets="all"/>
        <ProjectReference Include="..\UniversalToolchain.ModuleContracts\UniversalToolchain.ModuleContracts.csproj" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="GrEmit" Version="3.5.1"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\Dialects\examples\wist\**\dialect.wistdialect">
            <Link>Dialects\examples\wist\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Pack>true</Pack>
            <PackagePath>contentFiles/any/$(TargetFramework)/Dialects/examples/wist/%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
            <PackageFlatten>false</PackageFlatten>
        </Content>
    </ItemGroup>

    <Target Name="IncludeCanonicalWistRuntimeClosureInPackage" DependsOnTargets="Build;ResolveReferences">
        <MSBuild Projects="..\UniversalToolchain.Wist.LanguagePack\UniversalToolchain.Wist.LanguagePack.csproj"
                 Targets="GetWistLanguagePackRuntimeClosure"
                 Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);BuildProjectReferences=true"
                 BuildInParallel="false">
            <Output TaskParameter="TargetOutputs" ItemName="_WistLanguagePackRuntimeClosure" />
        </MSBuild>
        <ItemGroup>
            <_CanonicalWistRuntimeClosure Include="$(TargetPath);@(_WistLanguagePackRuntimeClosure)" />
            <BuildOutputInPackage Include="@(_CanonicalWistRuntimeClosure)" />
        </ItemGroup>
    </Target>

    <Target Name="MaterializeCanonicalWistRuntimeClosure"
            DependsOnTargets="Build;IncludeCanonicalWistRuntimeClosureInPackage">
        <Error Condition="'$(CanonicalWistRuntimeReferenceDirectory)' == ''"
               Text="CanonicalWistRuntimeReferenceDirectory must be provided when materializing the Wist runtime closure." />
        <MakeDir Directories="$(CanonicalWistRuntimeReferenceDirectory)" />
        <Copy SourceFiles="@(_CanonicalWistRuntimeClosure)"
              DestinationFolder="$(CanonicalWistRuntimeReferenceDirectory)"
              SkipUnchangedFiles="false" />
    </Target>

    <Target Name="IncludeFacadeReferenceAssemblyInPackage" DependsOnTargets="Build">
        <PropertyGroup>
            <WistFacadeReferenceAssembly>$(IntermediateOutputPath)ref/$(TargetFileName)</WistFacadeReferenceAssembly>
        </PropertyGroup>
        <Error Condition="!Exists('$(WistFacadeReferenceAssembly)')"
               Text="Wist facade reference assembly was not produced at '$(WistFacadeReferenceAssembly)'." />
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(WistFacadeReferenceAssembly)">
                <PackagePath>ref/$(TargetFramework)</PackagePath>
                <BuildAction>None</BuildAction>
            </TfmSpecificPackageFile>
        </ItemGroup>
    </Target>

    <Target Name="IncludeRuntimeManifestsInPackage">
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(TargetDir)*.toolchain.feature.json;$(TargetDir)*.dialect.runtime.json">
                <PackagePath>contentFiles/any/$(TargetFramework)</PackagePath>
                <BuildAction>Content</BuildAction>
                <PackageCopyToOutput>true</PackageCopyToOutput>
                <PackageFlatten>true</PackageFlatten>
            </TfmSpecificPackageFile>
        </ItemGroup>
    </Target>

    <Target Name="GetBuiltWistOutputDirectory"
            DependsOnTargets="Build"
            Returns="$(TargetDir)" />

</Project>
