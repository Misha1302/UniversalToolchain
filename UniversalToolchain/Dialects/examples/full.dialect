dialect Full version "1.0"
use Arithmetic
use Variables
use Scopes
use Conditions
use Labels
use Loops
requires Variables -> Scopes
before Conditions -> Labels
after Loops -> Labels
backend interpreter enable
backend cil enable
allow intrinsic "add_i32" for any
enable optimizer LocalVariablesOptimization for any
security trusted
capability safe-mode = true
capability diagnostics = true
