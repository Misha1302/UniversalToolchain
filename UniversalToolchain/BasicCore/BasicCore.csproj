<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\BasicTypesExtensions\BasicTypesExtensions.csproj"/>
        <ProjectReference Include="..\DotnetHelper\DotnetHelper.csproj"/>
        <ProjectReference Include="..\DynamicMethodWrapper\DynamicMethodWrapper.csproj"/>
        <ProjectReference Include="..\ObjectExtensions\ObjectExtensions.csproj"/>
        <ProjectReference Include="..\SettableGettableModule\SettableGettableModule.csproj"/>
        <ProjectReference Include="..\UniversalToolchain.Rules.Abstractions\UniversalToolchain.Rules.Abstractions.csproj"/>
        <ProjectReference Include="..\UniversalToolchain.Rules.Core\UniversalToolchain.Rules.Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\Intrinsics\Builtins\*.cs" Link="Intrinsics\Builtins\%(Filename)%(Extension)"/>
        <Compile Include="..\Intrinsics\Capabilities\*.cs" Link="Intrinsics\Capabilities\%(Filename)%(Extension)"/>
        <Compile Include="..\Intrinsics\Contracts\*.cs" Link="Intrinsics\Contracts\%(Filename)%(Extension)"/>
        <Compile Include="..\Intrinsics\Core\**\*.cs" Link="Intrinsics\Core\%(RecursiveDir)%(Filename)%(Extension)"/>
        <Compile Include="..\Intrinsics\Legacy\*.cs" Link="Intrinsics\Legacy\%(Filename)%(Extension)"/>
        <Compile Include="..\Intrinsics\Validation\*.cs" Link="Intrinsics\Validation\%(Filename)%(Extension)"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.1"/>
    </ItemGroup>

</Project>
