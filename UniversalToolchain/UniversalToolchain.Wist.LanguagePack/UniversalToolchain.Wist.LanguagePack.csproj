<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <IsPackable>true</IsPackable>
    <PackageId>UniversalToolchain.Wist.LanguagePack</PackageId>
    <Version>0.3.0-alpha.6</Version>
    <Description>Wist typed feature package and runtime provider for the UniversalToolchain Language SDK.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeToolchainFeatureManifest</TargetsForTfmSpecificContentInPackage>
    <FeatureManifestEmitterProjectPath>$(MSBuildThisFileDirectory)..\UniversalToolchain.FeatureManifestEmitter\UniversalToolchain.FeatureManifestEmitter.csproj</FeatureManifestEmitterProjectPath>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <AssemblyMetadata Include="UniversalToolchain.PackageVersion" Value="$(Version)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UniversalToolchain.FeatureSdk\UniversalToolchain.FeatureSdk.csproj" />
    <ProjectReference Include="..\UniversalToolchain.Runtime\UniversalToolchain.Runtime.csproj" />
    <ProjectReference Include="..\UniversalToolchain.ModuleContracts\UniversalToolchain.ModuleContracts.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\UniversalToolchain.Capabilities.Core\UniversalToolchain.Capabilities.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\UniversalToolchain.Diagnostics.Abstractions\UniversalToolchain.Diagnostics.Abstractions.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\UniversalToolchain.Dialects.Frontend\UniversalToolchain.Dialects.Frontend.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\AssemblyFinder\AssemblyFinder.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\BasicCore\BasicCore.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\AbstractIrExtensions\AbstractIrExtensions.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\DynamicMethodWrapper\DynamicMethodWrapper.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\BasicLexer\BasicLexer.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\BasicParser\BasicParser.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\AbstractIrConverters\AbstractIrConverters.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\BasicInterpreter\BasicInterpreter.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\BasicCilCompiler\BasicCilCompiler.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\BytecodeDynamicMethodsCompiler\BytecodeDynamicMethodsCompiler.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\BasicStdLib\BasicStdLib.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\ArithmeticModule\ArithmeticModule.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\CommentsModule\CommentsModule.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\ConditionsModule\ConditionsModule.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\CSharpInteropModule\CSharpInteropModule.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\EqualityModule\EqualityModule.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FunctionCallsModule\FunctionCallsModule.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\IdentifierModule\IdentifierModule.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\InternalPreprocessorLexemesModule\InternalPreprocessorLexemesModule.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\LabelsModule\LabelsModule.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\LoopsModule\LoopsModule.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\NativeMathModule\NativeMathModule.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\NumbersModule\NumbersModule.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\ParametersSetterModule\ParametersSetterModule.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\SafeMathFunctionsModule\SafeMathFunctionsModule.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\ScopesModule\ScopesModule.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\SemicolonAsNewLineModule\SemicolonAsNewLineModule.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\VariablesModule\VariablesModule.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\WhitespacesModule\WhitespacesModule.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\UniversalToolchain.Ssa.Optimization\UniversalToolchain.Ssa.Optimization.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\IntermediateRepresentationAbstractions\IntermediateRepresentationAbstractions.csproj" PrivateAssets="all" />
    <ProjectReference Include="$(FeatureManifestEmitterProjectPath)"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      PrivateAssets="all" />
  </ItemGroup>
  <Target Name="ResolveLanguagePackBuildProviders"
          AfterTargets="ResolveProjectReferences"
          BeforeTargets="EmitToolchainFeatureManifest"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="$(FeatureManifestEmitterProjectPath)"
             Targets="GetBuiltFeatureManifestEmitterTargetPath"
             Properties="BuildProjectReferences=true"
             BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_FeatureManifestEmitterTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <FeatureManifestEmitterResolvedDll>@(_FeatureManifestEmitterTargetPath)</FeatureManifestEmitterResolvedDll>
    </PropertyGroup>
    <Error Condition="'$(FeatureManifestEmitterResolvedDll)' == '' or !Exists('$(FeatureManifestEmitterResolvedDll)')"
           Text="Feature manifest emitter target path was not returned or does not exist: '$(FeatureManifestEmitterResolvedDll)'." />
  </Target>
  <Target Name="EmitToolchainFeatureManifest" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <ToolchainFeatureManifestPath>$(TargetDir)$(AssemblyName).toolchain.feature.json</ToolchainFeatureManifestPath>
    </PropertyGroup>
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;$(FeatureManifestEmitterResolvedDll)&quot; &quot;$(TargetPath)&quot; &quot;$(ToolchainFeatureManifestPath)&quot;" />
  </Target>
  <Target Name="IncludeToolchainFeatureManifest" DependsOnTargets="EmitToolchainFeatureManifest">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(ToolchainFeatureManifestPath)">
        <PackagePath>contentFiles/any/$(TargetFramework)</PackagePath>
        <BuildAction>Content</BuildAction>
        <PackageCopyToOutput>true</PackageCopyToOutput>
        <PackageFlatten>true</PackageFlatten>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
  <Target Name="GetWistLanguagePackRuntimeClosure"
          DependsOnTargets="Build;ResolveReferences"
          Returns="@(_WistLanguagePackRuntimeClosure)">
    <ItemGroup>
      <_WistLanguagePackRuntimeClosure Include="$(TargetPath)" />
      <_WistLanguagePackRuntimeClosure Include="@(ReferenceCopyLocalPaths)"
                                       Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
    </ItemGroup>
  </Target>
</Project>
