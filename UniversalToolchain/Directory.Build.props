<Project>

    <PropertyGroup>
        <!-- The net10 preview SDK used by this repository can fail project-reference graph
             discovery nondeterministically when restore/build walks this large graph in
             parallel. Keep project-reference traversal serial for reproducible local and CI
             builds without changing legacy transitive-reference behavior globally. -->
        <BuildInParallel>false</BuildInParallel>
        <RestoreBuildInParallel>false</RestoreBuildInParallel>
        <RestoreUseStaticGraphEvaluation>true</RestoreUseStaticGraphEvaluation>
        <UseSharedCompilation>false</UseSharedCompilation>

        <!-- Runtime identity generation 2 intentionally breaks binary unification with
             pre-hardening checkouts. The old graph shipped every assembly as 1.0.0.0,
             allowing incompatible DLLs to bind by simple identity and fail much later. -->
        <AssemblyVersion>2.0.0.0</AssemblyVersion>
        <FileVersion>2.0.0.0</FileVersion>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <DeterministicSourcePaths>true</DeterministicSourcePaths>
        <CanonicalRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</CanonicalRepositoryRoot>
        <PathMap>$(CanonicalRepositoryRoot)=/_</PathMap>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="System.Reflection.MetadataLoadContext"
                   HintPath="$(MSBuildToolsPath)/System.Reflection.MetadataLoadContext.dll"
                   Condition="Exists('$(MSBuildToolsPath)/System.Reflection.MetadataLoadContext.dll')" />
        <Compile Include="$(MSBuildThisFileDirectory)BuildSupport/JetBrainsAnnotations.cs"
                 Link="BuildSupport/JetBrainsAnnotations.cs"
                 Condition="Exists('$(MSBuildThisFileDirectory)BuildSupport/JetBrainsAnnotations.cs')" />
    </ItemGroup>

</Project>
