<Project>

    <PropertyGroup>
        <!-- Parallel graph traversal is the normal repository mode. Every property remains
             command-line overridable so diagnostics can reproduce the legacy isolated path.
             Solutions are still built sequentially because Wist.sln and PlanFuzz.sln share
             output directories. -->
        <BuildInParallel Condition="'$(BuildInParallel)' == ''">true</BuildInParallel>
        <RestoreBuildInParallel Condition="'$(RestoreBuildInParallel)' == ''">true</RestoreBuildInParallel>
        <RestoreUseStaticGraphEvaluation>true</RestoreUseStaticGraphEvaluation>
        <UseSharedCompilation Condition="'$(UseSharedCompilation)' == ''">true</UseSharedCompilation>

        <!-- Runtime identity generation 2 intentionally breaks binary unification with
             pre-hardening checkouts. The old graph shipped every assembly as 1.0.0.0,
             allowing incompatible DLLs to bind by simple identity and fail much later. -->
        <AssemblyVersion>2.0.0.0</AssemblyVersion>
        <FileVersion>2.0.0.0</FileVersion>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <DeterministicSourcePaths>true</DeterministicSourcePaths>
        <CanonicalRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</CanonicalRepositoryRoot>
        <PathMap>$(CanonicalRepositoryRoot)=/_</PathMap>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="$(MSBuildThisFileDirectory)BuildSupport/JetBrainsAnnotations.cs"
                 Link="BuildSupport/JetBrainsAnnotations.cs"
                 Condition="Exists('$(MSBuildThisFileDirectory)BuildSupport/JetBrainsAnnotations.cs')" />
    </ItemGroup>

</Project>
